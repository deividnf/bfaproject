generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  planId    String?   
  plan      Plan?     @relation(fields: [planId], references: [id])

  apiKeys      ApiKey[]
  usageEvents  UsageEvent[]
  invoices     Invoice[]

  @@index([status])
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model ApiKey {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  keyHash   String
  label     String?
  status    ApiKeyStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  revokedAt DateTime?
  expiresAt DateTime?

  @@index([tenantId])
  @@index([status])
  @@unique([tenantId, keyHash])
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)

  // Simplificação: limites mensais genéricos, extensível para JSON futuramente
  monthlyRequestLimit Int?

  tenants     Tenant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model UsageEvent {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  metricName     String
  value          Decimal  @db.Decimal(18, 6)
  occurredAt     DateTime

  idempotencyKey String
  source         String? // origem do evento (serviço chamador)

  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([tenantId, occurredAt])
  @@index([metricName])
  @@unique([tenantId, idempotencyKey])
}

model Invoice {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])

  billingCycleStart DateTime
  billingCycleEnd   DateTime

  amount            Decimal       @db.Decimal(18, 6)
  currency          String        @default("USD")

  status            InvoiceStatus @default(DRAFT)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, billingCycleStart, billingCycleEnd])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}
